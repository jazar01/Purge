<Project>
  <!-- Shared by Purge.exe and PurgeWindow.exe, so both always report the same version. -->
  <PropertyGroup>
    <Version>2.6.0</Version>
    <!-- Show the version as plain "2.6.0", without "+<git commit hash>" appended. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Purge</Product>
    <Copyright>Copyright © 2020-2026</Copyright>
  </PropertyGroup>
</Project>
