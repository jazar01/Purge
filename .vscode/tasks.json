{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Build Purge, PurgeWindow and the tests (Debug).",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/Purge.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "make sample files",
            "detail": "Rebuild the throwaway %TEMP%\\PurgeDebug folder the debug configurations work on.",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/make-samples.ps1"],
            "problemMatcher": [],
            "presentation": { "reveal": "silent" }
        },
        {
            "label": "build and make sample files",
            "dependsOrder": "sequence",
            "dependsOn": ["build", "make sample files"],
            "problemMatcher": []
        },
        {
            "label": "test",
            "detail": "Run all the tests.",
            "type": "process",
            "command": "dotnet",
            "args": ["test", "${workspaceFolder}/Purge.sln"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "test", "isDefault": true }
        }
    ]
}
