<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purge</RootNamespace>
    <AssemblyName>Purge</AssemblyName>
    <Version>2.2.0</Version>
    <Product>Purge</Product>
    <Description>Advanced file purging: delete old files while always keeping a minimum number.</Description>
    <Copyright>Copyright © 2020-2026</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

</Project>
