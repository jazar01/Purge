<Project Sdk="Microsoft.NET.Sdk">

  <!-- Version, Product and Copyright are set in Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purge</RootNamespace>
    <AssemblyName>Purge</AssemblyName>
    <Description>Advanced file purging: delete old files while always keeping a minimum number.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

</Project>
